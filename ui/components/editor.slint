import {
    Button,
    VerticalBox,
    ComboBox,
    Slider,
    TextEdit,
} from "std-widgets.slint";
import { DebugPopup } from "debug.slint";
import { Timeline } from "timeline.slint";

export component AppWindow inherits Window {
    default-font-size: 10pt;
    //-width: 1920px;
    //preferred-height: 1080px;

    in property <image> texture;
    in property <string> render_backend;
    in property <string> device;
    in property <string> device_capabilities;

    in property <string> filename;
    in property <string> sensor;
    in property <string> events: "0";
    in property <string> duration: "0 µs";
    in property <string> file_error;
    in property <bool> file_loading;
    in property <int> current_timestamp: 0;
    in property <string> current_timestamp_formatted;
    in property <float> offset_s;
    in property <int> preview_width;
    in property <int> preview_height;
    in property <image> preview_texture  <=>  preview_canvas.source;
    in property <image> timeline_svg  <=>  timeline.timeline_svg;

    callback open_file();

    pure callback render_timeline(float, float) -> image;

    callback decay_mode_changed(string);

    callback pause_play(is_paused: bool);

    callback skip_forward();

    callback skip_backward();

    callback skip_start_end(is_start: bool);

    callback decay_constant_changed(decay_ms: int);

    debug_menu := DebugPopup {
        texture: root.texture;
        render_backend: root.render_backend;
        device: root.device;
        device_capabilities: root.device_capabilities;
    }

    MenuBar {
        Menu {
            title: "File";

            MenuItem {
                title: "Open...";
                enabled: !root.file_loading;
                activated => { root.open_file(); }
            }

            MenuItem {
                title: "Quit";
            }
        }

        Menu {
            title: "Debug";

            MenuItem {
                title: "GPU info";
                activated => {
                    debug_menu.show()
                }
            }
        }
    }

    FlexboxLayout {
        width: 100%;
        height: 100%;
        spacing: 5px;
        padding: 5px;
        flex-direction: column;

        property <int> decay_constant: 50;
        property <string> decay_type: "Linear";
        property <int> ts_current: 0;
        property <string> pause_play_icon: "▶︎";

        FlexboxLayout {
            height: 70%;
            width: 100%;
            spacing: 8px;
            flex-direction: row;

            // Preview window
            preview_window := Rectangle {
                min-width: 200px;
                preview_canvas := Image { }
            }

            Rectangle {
                width: 10%;
                border-width: 1px;
                border-color: #777777;
                VerticalLayout {
                    alignment: stretch;
                    padding: 10px;
                    spacing: 5px;
                    Text {
                        font-italic: false;
                        font-weight: FontWeight.bold;
                        font-size: 24px;
                        text: "Source";
                    }

                    Text {
                        text: "File: " + filename;
                    }

                    Text {
                        text: "Sensor: " + sensor;
                    }

                    Text {
                        text: "Total events: " + events;
                    }

                    Text {
                        text: "Duration: " + duration;
                    }

                    Text {
                        visible: root.file_loading;
                        text: "Opening file...";
                    }

                    Text {
                        visible: root.file_error != "";
                        text: root.file_error;
                        overflow: elide;
                    }
                    // divider
                    Rectangle {
                        height: 1px;
                        background: #777777;
                    }

                    Text {
                        font-italic: false;
                        font-weight: FontWeight.bold;
                        font-size: 24px;
                        text: "Open visualisations: ";
                    }

                    HorizontalLayout {
                        Text {
                            text: "Visualisation: ";
                        }

                        ComboBox {
                            model: ["Time surface", "Voxel", "Depth map", "FRME", "IMU"];
                            current-value: "Time surface";
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Decay constant: ";
                        }

                        Slider {
                            minimum: 1;
                            maximum: 200;
                            value: decay_constant;
                            changed(value) => {
                                decay_constant = value;
                                root.decay_constant_changed(value)
                            }
                        }

                        TextInput {
                            input-type: number;
                            text: decay_constant;
                        }

                        Text {
                            text: " ms";
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Decay: ";
                        }

                        ComboBox {
                            model: ["Exponential", "Linear"];
                            current-value: "Exponential";
                            selected(current_value) => {
                                root.decay_mode_changed(current_value);
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #777777;
                    }

                    Text {
                        font-italic: false;
                        font-weight: FontWeight.bold;
                        font-size: 24px;
                        text: "Playback";
                    }

                    Text {
                        text: "Timestamp: " + ts_current;
                    }

                    Text {
                        text: "Events: " + events;
                    }

                    Text {
                        text: "Polarity: ";
                    }

                    Rectangle {
                        height: 35%;
                        background: #777777;
                        Text {
                            text: "POLARITY HISTOGRAM";
                        }
                    }
                }
            }
        }

        FlexboxLayout {
            alignment: start;
            spacing: 20px;
            height: 2%;
            // TODO: use proper icons rather than ASCII, these are just placeholder
            Button {
                text: "⏮";
                clicked => {
                    skip_start_end(true)
                }
            }

            Button {
                text: "<";
                clicked => {
                    skip_backward()
                }
            }

            Button {
                text: pause_play_icon;
                clicked => {
                    pause_play_icon = pause_play_icon == "⏸" ? "▶︎" : "⏸";
                    pause_play(pause_play_icon == "▶︎");
                }
            }

            Button {
                text: ">";
                clicked => {
                    skip_forward()
                }
            }

            Button {
                text: "⏭";
                clicked => {
                    skip_start_end(false)
                }
            }

            HorizontalLayout {
                TextInput {
                    input-type: decimal;
                    text: 1;
                }

                Text {
                    text: "x";
                }
            }

            HorizontalLayout {
                Text {
                    text: "ts: ";
                }

                TextInput {
                    input-type: decimal;
                    text: current_timestamp_formatted;
                }

                Text {
                    text: " offset:  " + offset_s + " s";
                }
            }
        }

        timeline := Timeline {
            width: 100%;
            height: 28%;
        }
    }
}
