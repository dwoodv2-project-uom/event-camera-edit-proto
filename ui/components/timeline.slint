export component Timeline {
    width: 100%;
    height: 100%;
    in property <image> timeline_svg  <=>  timeline_canvas.source;


    Rectangle {
        width: 100%;
        height: 100%;

        timeline_canvas := Image {
            width: 100%;
            height: 100%;
            preferred-width: 0px;
            preferred-height: 0px;
        }
    }
}
