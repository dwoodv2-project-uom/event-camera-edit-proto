export component Timeline {
    width: 100%;
    height: 100%;

    pure callback on_render_timeline(/* width */ float, /* height */ float) -> image;

    Rectangle {
        width: 100%;
        height: 100%;

        Image {
            width: 100%;
            height: 100%;
            preferred-width: 0px;
            preferred-height: 0px;
            source: root.on_render_timeline(root.width / 1px, root.height / 1px);
        }
    }
}
